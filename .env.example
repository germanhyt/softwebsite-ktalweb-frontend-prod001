# Resend (formulario / correo)
RESEND_API=

# NVIDIA NIM (GLM) — https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=z-ai/glm-5.2

# Timeout hacia el LLM en ms (local puede ser más alto)
CHAT_UPSTREAM_MS=20000

# Puerto del API local (yarn dev:api)
# CHAT_API_PORT=3001
