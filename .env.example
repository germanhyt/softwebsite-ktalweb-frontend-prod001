# Resend (formulario / correo)
RESEND_API=

# NVIDIA NIM — https://build.nvidia.com / https://integrate.api.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Compatibilidad (si aún usas la URL completa de completions)
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Parámetros del chat (defaults alineados a Nemotron)
CHAT_TEMPERATURE=1
CHAT_TOP_P=0.95
CHAT_MAX_TOKENS=2048
# En Vercel dejar false (JSON completo). true = SSE stream.
CHAT_STREAM=false
# Timeout hacia el LLM en ms (Nemotron + thinking puede necesitar más)
CHAT_UPSTREAM_MS=45000

# Puerto del API local (yarn dev:api)
# CHAT_API_PORT=3001
